PORT=4000
# Desarrollo local: dejar DB_URL vacío y se usará SQLite
DB_URL=
# Para PostgreSQL, configurar DB_URL y opcionalmente DB_SSL=true
DB_SSL=false
FRONTEND_ORIGIN=http://localhost:5173
# Contraseña para ingresar al panel privado de administración (usar una contraseña fuerte)
ADMIN_PASSWORD=
# Credenciales del panel de API de Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
